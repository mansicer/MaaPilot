# MaaPilot：Codex 的命令规则（和 .claude/settings.json 的权限一一对应，tests/test_hosts.py 检查）。
# allow 在沙箱外跑、不弹确认；prompt 每次问用户（无头 codex exec 里等于拒绝）；forbidden 一律拒绝。
# 只有合成玉 / 源石的放行（guard allow）要问；其余以用户在对话里的同意为准。
# 禁止的只有绕过锁和对账的直接操作（直接用 maa 跑任务、直接 adb shell）和森空岛凭据。
# 规则按命令的第一个词认程序，所以 maapilot 的几种写法（PATH 里的、.venv 里的、Windows 的 .exe）、adb / maa 的 .exe 都列上。
# Windows 上 Codex 经 PowerShell 跑命令，规则看到的是不是这样拆开的命令还没核实过；写绝对路径的也认不出来
# （拦直接操作靠的是锁、对账和 AGENTS.md 的硬规则，这里只是一道护栏）。
MAAPILOT = ["maapilot", ".venv/bin/maapilot", "maapilot.exe", ".venv\\Scripts\\maapilot.exe", ".venv/Scripts/maapilot.exe"]
MAA = ["maa", "maa.exe"]
ADB = ["adb", "adb.exe"]

# maapilot 后面的部分
ALLOW = [
    [["doctor", "screen", "input", "maa", "state", "data", "calc", "goals", "op", "craft", "report", "reset"]],
    ["daily", ["run", "status", "watch", "schedule", "unschedule"]],
    ["guard", ["snapshot", "check", "status"]],
    ["lock", ["status", "release"]],
    ["skland", "status"],
    ["host", ["status", "install"]],
    ["news", ["list", "show", "told"]],
    ["game", ["version", "update"]],
    ["copilot", ["find", "show", "strip"]],
]
PROMPT = [
    ["guard", "allow"],
]
FORBIDDEN = [
    ["skland", "token"],
]
for prog in MAAPILOT:
    for p in ALLOW:
        prefix_rule(pattern = [prog] + p, decision = "allow")
    for p in PROMPT:
        prefix_rule(pattern = [prog] + p, decision = "prompt")
    for p in FORBIDDEN:
        prefix_rule(pattern = [prog] + p, decision = "forbidden", justification = "MaaPilot：森空岛凭据只由用户自己处理")
prefix_rule(pattern = ["sleep", "300"], decision = "allow")
for prog in MAA:
    prefix_rule(pattern = [prog, ["run", "fight", "copilot", "ssscopilot", "roguelike", "reclamation", "startup", "closedown"]],
                decision = "forbidden", justification = "MaaPilot：只通过 maapilot 操作模拟器")
for prog in ADB:
    prefix_rule(pattern = [prog, ["shell", "-s"]], decision = "forbidden", justification = "MaaPilot：只通过 maapilot 操作模拟器")
