#!/bin/sh
# 启动脚本：不用激活虚拟环境。第一次用时在仓库里建 .venv 并装好 maapilot，之后直接转给 .venv/bin/maapilot。
set -e
ROOT=$(cd "$(dirname "$0")/.." && pwd)
VENV="$ROOT/.venv"
if [ ! -x "$VENV/bin/maapilot" ]; then
  PY=""
  for c in python3.12 python3.13 python3; do
    if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(sys.version_info < (3, 12))' 2>/dev/null; then PY=$c; break; fi
  done
  if [ -z "$PY" ]; then
    case " $* " in
      *" --hook "*)    # 启动钩子：按 Claude Code 钩子的格式说，agent 才看得到、用户也看得到
        echo '{"systemMessage": "MaaPilot 需要 Python 3.12 以上，这台电脑上还没有。随便说一句，我帮你装。", "hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": "MaaPilot 启动检查：bin/maapilot 找不到 Python 3.12 以上（error.code no_python），命令都用不了。加载 skill maapilot-setup，按其中「没有 Python」一节先帮用户装 Python。"}}'
        exit 0 ;;
    esac
    echo '{"ok": false, "command": "bootstrap", "data": null, "error": {"code": "no_python", "message": "需要 Python 3.12 以上", "hint": "brew install python@3.12"}}'
    exit 5
  fi
  echo "maapilot: 第一次使用，正在建虚拟环境并安装（约一两分钟）…" >&2
  [ -x "$VENV/bin/python" ] || "$PY" -m venv "$VENV" >&2
  "$VENV/bin/pip" install -q -e "$ROOT" >&2
fi
exec "$VENV/bin/maapilot" "$@"
