{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(maapilot:*)",
      "Bash(sleep 300)",
      "Read(private/**)",
      "Edit(private/config.yaml)",
      "Edit(private/goals.md)",
      "Edit(private/goals-done.md)",
      "Edit(private/setup.json)",
      "Edit(private/shots/**)",
      "WebFetch(domain:prts.maa.plus)",
      "WebFetch(domain:prts.plus)",
      "WebFetch(domain:maa.plus)"
    ],
    "ask": [
      "Bash(maapilot guard allow:*)",
      "Bash(maapilot dev:*)"
    ],
    "deny": [
      "Bash(maapilot skland token:*)",
      "Bash(.venv/bin/maapilot skland token:*)",
      "Bash(maapilot.exe skland token:*)",
      "Bash(.venv\\Scripts\\maapilot.exe skland token:*)",
      "Bash(.venv/Scripts/maapilot.exe skland token:*)",
      "Bash(maa run:*)",
      "Bash(maa fight:*)",
      "Bash(maa copilot:*)",
      "Bash(maa ssscopilot:*)",
      "Bash(maa roguelike:*)",
      "Bash(maa reclamation:*)",
      "Bash(maa startup:*)",
      "Bash(maa closedown:*)",
      "Bash(maa.exe run:*)",
      "Bash(maa.exe fight:*)",
      "Bash(maa.exe copilot:*)",
      "Bash(maa.exe ssscopilot:*)",
      "Bash(maa.exe roguelike:*)",
      "Bash(maa.exe reclamation:*)",
      "Bash(maa.exe startup:*)",
      "Bash(maa.exe closedown:*)",
      "Bash(adb shell:*)",
      "Bash(adb -s:*)",
      "Bash(adb.exe shell:*)",
      "Bash(adb.exe -s:*)",
      "Edit(private/guard/**)",
      "Edit(private/lock.json)",
      "Read(private/skland.json)",
      "Edit(private/skland.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/session-start",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
